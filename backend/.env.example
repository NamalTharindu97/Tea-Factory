# Copy this file to .env and adjust the values for your environment.
# backend/.env is required to run the server and the backend tests outside Docker.
# NOTE: Keep secrets out of git. The committed backend/.env holds production Atlas
# credentials and must never be rotated, leaked, or deleted (see AGENTS.md).
#
# KEY=value format only (no spaces around "=") because Docker Compose env_file and
# the backend container rely on it.
CONNECTION_STRING=mongodb://localhost:27017/Tea-Factory
ACCESS_TOKEN_SECRET=change-me-in-production
PORT=5000
